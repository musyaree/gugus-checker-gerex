// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Region {
  id        Int       @id @default(autoincrement())
  nama      String    @unique
  gugus     Gugus[]
  createdAt DateTime  @default(now())

  @@map("regions")
}

model Gugus {
  id        Int         @id @default(autoincrement())
  nama      String      @unique
  regionId  Int
  region    Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  mahasiswa Mahasiswa[]
  createdAt DateTime    @default(now())

  @@map("gugus")
}

model Mahasiswa {
  id        Int       @id @default(autoincrement())
  nrp       String    @unique
  nama      String
  fotoUrl   String?
  gugusId   Int
  gugus     Gugus     @relation(fields: [gugusId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([nrp])
  @@map("mahasiswa")
}
